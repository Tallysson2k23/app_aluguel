{
  "name": "aluguel-map",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost",
    "build": "tsc --noEmit && vite build",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-aluguel-map",
    "seed": "node scripts/seed.mjs",
    "test": "firebase emulators:exec --config firebase.test.json --only firestore --project demo-aluguel-map-rules \"node --test tests/rules.test.mjs\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.51.0",
    "@types/leaflet": "^1.9.0",
    "@types/leaflet.markercluster": "^1.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-tools": "^15.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.7"
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}

