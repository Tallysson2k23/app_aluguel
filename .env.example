# Em desenvolvimento, o modo local é usado por padrão.
VITE_USE_EMULATORS=true
# Para o Firebase real, copie a configuração Web do Console e defina false acima.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
# Opcionais. Forneça a atribuição exigida pelo provedor.
VITE_TILE_URL=
VITE_TILE_ATTRIBUTION=
